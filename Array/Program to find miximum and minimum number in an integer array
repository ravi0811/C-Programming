//Program to find miximum and minimum number in an integer array

#include<stdio.h>
void main(){
    int arr[5]={10,4,5,7,6};
    int max=arr[0],min=arr[0],i;
    for(i=1;i<5;i++){
        if (arr[i]>max){
            max=arr[i];
        }
        if(arr[i]<min){
            min=arr[i];
        }
    }
    printf("Max = %d\nMin = %d",max,min);
}
